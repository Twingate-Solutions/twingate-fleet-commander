# Fleet Commander — environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env`.

# --- Secrets (never put these in the YAML config) ---
TWINGATE_NETWORK=acme            # network slug for https://acme.twingate.com
TWINGATE_API_KEY=tgp_xxxxxxxx    # Admin or DevOps role; create/delete connectors

# --- Process config ---
FC_CONFIG_PATH=/app/config/config.yaml
FC_STATE_PATH=/app/state/fc.sqlite3
FC_LOG_LEVEL=info               # debug|info|warning|error
DOCKER_HOST=unix:///var/run/docker.sock

# --- Status UI / overrides (optional) ---
FC_OVERRIDE_ENABLED=false       # gate manual scale/cordon endpoints
FC_OVERRIDE_SECRET=             # shared-secret header value when overrides enabled (>=16 chars)

# No seed-connector or token variables are needed: FC self-provisions its fleet
# for every Remote Network listed in config.yaml, minting tokens via the Twingate
# API and injecting them directly into the containers it runs. The image FC
# provisions is set by `connector_image` in config.yaml, not here.
