# Fleet Commander — environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env`.

# --- Secrets (never put these in the YAML config) ---
TWINGATE_NETWORK=acme            # network slug for https://acme.twingate.com
TWINGATE_API_KEY=tgp_xxxxxxxx    # Admin or DevOps role; create/delete connectors

# --- Process config ---
FC_CONFIG_PATH=/app/config/config.yaml
FC_STATE_PATH=/app/state/fc.sqlite3
FC_LOG_LEVEL=info               # debug|info|warning|error
DOCKER_HOST=unix:///var/run/docker.sock

# --- Compute backend (explicit; never auto-detected) ---
# docker (default) drives the local Docker socket; ecs/aci drive the cloud
# actuators. See docs/platforms/ecs.md and docs/platforms/aci.md.
FC_PLATFORM=docker              # docker | ecs | aci

# ─── AWS ECS backend (only when FC_PLATFORM=ecs) ───────────────────────────
# Placement only — AWS identity comes from the task/instance role or AWS_* env,
# NOT from these vars. Lists accept JSON or comma-separated values.
# FC_ECS__CLUSTER=fc-cluster
# FC_ECS__SUBNETS=subnet-aaaa,subnet-bbbb
# FC_ECS__SECURITY_GROUPS=sg-aaaa
# FC_ECS__REGION=us-east-1
# FC_ECS__ASSIGN_PUBLIC_IP=false
# FC_ECS__LAUNCH_TYPE=FARGATE          # FARGATE | EC2 (1 vCPU/2 GB valid on both)
# FC_ECS__TASK_ROLE_ARN=arn:aws:iam::<acct>:role/fc-connector-task
# FC_ECS__EXECUTION_ROLE_ARN=arn:aws:iam::<acct>:role/fc-connector-exec
# FC_ECS__LOG_GROUP=/fc/connectors     # CloudWatch Logs group (enables collection)
# FC_ECS__LOG_STREAM_PREFIX=fc

# ─── Azure ACI backend (only when FC_PLATFORM=aci) ─────────────────────────
# Identity defaults to managed identity / the Azure credential chain. Set the
# service-principal trio only for an explicit SP (client_secret is the only
# bespoke secret here).
# FC_ACI__SUBSCRIPTION_ID=<sub-guid>
# FC_ACI__RESOURCE_GROUP=fc-rg
# FC_ACI__REGION=eastus
# FC_ACI__SUBNET_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>
# FC_ACI__LOG_ANALYTICS_WORKSPACE_ID=<workspace-guid>   # enables log collection
# FC_ACI__TENANT_ID=<tenant-guid>      # service principal (optional)
# FC_ACI__CLIENT_ID=<client-guid>      # service principal (optional)
# FC_ACI__CLIENT_SECRET=               # service principal secret (optional)

# --- Status UI / overrides (optional) ---
FC_OVERRIDE_ENABLED=false       # gate manual scale/cordon/replace endpoints
FC_OVERRIDE_SECRET=             # shared-secret header value when overrides enabled (>=16 chars)

# ─── log-shipper (OPTIONAL — only with `docker compose --profile shipping up`) ──
# Nice-to-have: pushes connector real-time analytics / stdout to an S3-compatible
# bucket (Twingate ships natively to AWS S3 only; this covers NON-AWS buckets such
# as GCS via S3 interop). The shipper reads container LOG FILES, not the Docker
# socket. These vars are consumed by the `log-shipper` service, never by FC.
# Leave the whole block unset if you don't run the shipper.
#
# Required:
TWINGATE_SHIPPER_S3_BUCKET=                  # destination bucket name
TWINGATE_SHIPPER_S3_ACCESS_KEY_ID=           # S3 (or GCS HMAC) access key id
TWINGATE_SHIPPER_S3_SECRET_ACCESS_KEY=       # S3 (or GCS HMAC) secret access key
#
# GCS via S3 interop (the documented test target): point the endpoint at GCS and
# use a GCS HMAC key pair (Cloud Storage → Settings → Interoperability) as the
# access key id / secret above. For real AWS S3, leave the endpoint blank.
TWINGATE_SHIPPER_S3_ENDPOINT_URL=            # e.g. https://storage.googleapis.com for GCS
TWINGATE_SHIPPER_S3_REGION=                  # e.g. auto (GCS) or us-east-1 (AWS)
TWINGATE_SHIPPER_S3_PREFIX=                  # optional key prefix, e.g. fc/connectors/
#
# Container filter — the shipper only ships containers whose name CONTAINS this
# substring. The default `twingate/connector` does NOT match the custom image, so
# set it to match the connector image FC provisions (config.yaml -> connector_image).
TWINGATE_SHIPPER_DOCKER_CONTAINER_NAME_FILTER=twingate-custom-connector-container

# No seed-connector or token variables are needed: FC self-provisions its fleet
# for the single Remote Network set by `remote_network_id` in config.yaml (Key
# Design Rule N1 — one FC instance manages exactly one Remote Network), minting
# tokens via the Twingate API and injecting them directly into the containers it
# runs. The image FC provisions is set by `connector_image` in config.yaml, not here.
